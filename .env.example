# Otari API key — create it at otari.ai -> your workspace -> API keys -> Create key.
# The token starts with otk_ and is shown only once. Never commit a real key.
OTARI_API_KEY=otk_...

# Optional overrides (defaults shown):
# OTARI_BASE_URL=https://api.otari.ai/api/v1
# OTARI_MODEL_PLANNER=openai/gpt-oss-20b
# OTARI_MODEL_RESEARCHER=deepseek/deepseek-v4-flash
# OTARI_MODEL_CRITIC=z-ai/glm-flash
# OTARI_GATEWAY_TOOLS=1
